#!/usr/bin/env python3
"""dellmon — control a Dell monitor (input / KVM / brightness) over DDC/CI from macOS or Linux.

  dellmon status                 show current input, brightness, contrast
  dellmon learn <name>           save the *current* input (+optional usb) as setup <name>
  dellmon switch <name>          switch monitor to setup <name>   (alias: dellmon <name>)
  dellmon toggle                 switch to the "other" setup (works with exactly 2 setups)
  dellmon input <hex>            set input source directly (VCP 0x60), e.g. 0x0f
  dellmon brightness [0-100|+n|-n]
  dellmon contrast   [0-100|+n|-n]
  dellmon get <vcp>              raw read  -> "cur max"
  dellmon set <vcp> <value>      raw write (16-bit value ok, e.g. 0xff00)
  dellmon scan [from] [to]       dump readable VCP codes (macOS helper only)
  dellmon config                 print resolved config path + content

Backends: macOS -> ./macos/ddcvcp (private IOAVService I2C), Linux -> ddcutil.
Config: $DELLMON_CONFIG, ~/.config/dellmon/config.json, or ./config.json next to this script.
"""
import json, os, re, shutil, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
VCP_INPUT, VCP_BRIGHT, VCP_CONTRAST = 0x60, 0x10, 0x12

INPUT_NAMES = {0x0F: "DP", 0x10: "DP2", 0x11: "HDMI1", 0x12: "HDMI2",
               0x19: "USB-C/TB (0x19)", 0x1B: "USB-C (0x1B)"}

DEFAULT_CONFIG = {
    "setups": {},               # name -> {"input": "0x19", "usb": "0xff00" (optional)}
    "usb_vcp": "0xE7",          # Dell KVM USB-upstream select code (only used if a setup has "usb")
    "ddcutil_args": [],         # linux: e.g. ["--bus", "7"] or ["--display", "1"]
    "mac_display": 1,           # macOS: index from `ddcvcp list`
}


# ---------- config ----------
def config_path():
    for p in (os.environ.get("DELLMON_CONFIG"),
              os.path.expanduser("~/.config/dellmon/config.json"),
              os.path.join(HERE, "config.json")):
        if p and os.path.exists(p):
            return p
    return os.path.expanduser("~/.config/dellmon/config.json")


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    p = config_path()
    if os.path.exists(p):
        with open(p) as f:
            cfg.update(json.load(f))
    return cfg


def save_config(cfg):
    p = config_path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    return p


def num(s):
    s = str(s).strip().lower()
    return int(s, 16) if s.startswith("0x") else int(s)


# ---------- backends ----------
class Mac:
    def __init__(self, cfg):
        self.bin = os.path.join(HERE, "macos", "ddcvcp")
        if not os.path.exists(self.bin):
            src = os.path.join(HERE, "macos", "ddcvcp.swift")
            print("building macos/ddcvcp ...", file=sys.stderr)
            subprocess.run(["swiftc", "-O", "-o", self.bin, src, "-framework", "IOKit",
                            "-framework", "Foundation"], check=True)
        self.disp = ["-d", str(cfg.get("mac_display", 1))]

    def _run(self, *a):
        r = subprocess.run([self.bin, *self.disp, *a], capture_output=True, text=True)
        if r.returncode:
            raise RuntimeError(r.stderr.strip() or f"ddcvcp failed: {a}")
        return r.stdout

    def get(self, vcp):
        cur, mx = self._run("get", hex(vcp)).split()
        return int(cur), int(mx)

    def set(self, vcp, val):
        self._run("set", hex(vcp), hex(val))

    def scan(self, a, b):
        sys.stdout.write(self._run("scan", hex(a), hex(b)))


class Linux:
    def __init__(self, cfg):
        if not shutil.which("ddcutil"):
            sys.exit("ddcutil not found (apt install ddcutil / dnf install ddcutil), and load i2c-dev")
        self.extra = list(cfg.get("ddcutil_args", []))

    def _run(self, *a):
        r = subprocess.run(["ddcutil", *self.extra, *a], capture_output=True, text=True)
        if r.returncode:
            raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"ddcutil failed: {a}")
        return r.stdout

    def get(self, vcp):
        # --brief forms:  "VCP 10 C 70 100" | "VCP 60 SNC x0f" | "VCP E7 CNC xb8 x00 x00 x00"
        out = self._run("getvcp", f"0x{vcp:02x}", "--brief").strip()
        parts = out.split()
        typ = parts[2] if len(parts) > 2 else ""
        vals = [int(p[1:], 16) if p.startswith("x") else int(p) for p in parts[3:]]
        if typ == "C" and len(vals) >= 2:
            return vals[0], vals[1]
        if typ == "SNC" and vals:
            return vals[0], 0
        if typ == "CNC" and len(vals) >= 4:
            return (vals[2] << 8) | vals[3], (vals[0] << 8) | vals[1]
        raise RuntimeError(f"unparsed ddcutil output: {out!r}")

    def set(self, vcp, val):
        self._run("setvcp", f"0x{vcp:02x}", f"0x{val:04x}", "--noverify")

    def scan(self, a, b):
        for code in range(a, b + 1):
            try:
                cur, mx = self.get(code)
                print(f"0x{code:02X}: cur=0x{cur:04X} ({cur}) max=0x{mx:04X} ({mx})")
            except RuntimeError:
                pass


def backend(cfg):
    if sys.platform == "darwin":
        return Mac(cfg)
    if sys.platform.startswith("linux"):
        return Linux(cfg)
    sys.exit(f"unsupported platform {sys.platform}")


# ---------- commands ----------
def cur_input(be):
    cur, _ = be.get(VCP_INPUT)
    return cur & 0xFF   # Dell echoes the value in both bytes (0x1919)


def fmt_input(v):
    return f"0x{v:02x} {INPUT_NAMES.get(v, '')}".strip()


def cmd_status(be, cfg, _):
    inp = cur_input(be)
    name = next((n for n, s in cfg["setups"].items() if num(s["input"]) == inp), None)
    print(f"input:      {fmt_input(inp)}" + (f"  [{name}]" if name else ""))
    for label, code in (("brightness", VCP_BRIGHT), ("contrast", VCP_CONTRAST)):
        try:
            print(f"{label + ':':<12}{be.get(code)[0]}")
        except RuntimeError as e:
            print(f"{label + ':':<12}? ({e})")
    if cfg["setups"]:
        print("setups:     " + ", ".join(f"{n}={s['input']}" for n, s in cfg["setups"].items()))


def cmd_learn(be, cfg, args):
    if not args:
        sys.exit("usage: dellmon learn <name> [--usb <hex>]")
    name = args[0]
    entry = {"input": f"0x{cur_input(be):02x}"}
    if "--usb" in args:
        entry["usb"] = args[args.index("--usb") + 1]
    cfg["setups"][name] = entry
    p = save_config(cfg)
    print(f"saved setup '{name}' = {entry} -> {p}")


def apply_setup(be, cfg, name):
    s = cfg["setups"].get(name)
    if not s:
        sys.exit(f"unknown setup '{name}'. known: {', '.join(cfg['setups']) or '(none — run `dellmon learn <name>` on each machine)'}")
    if "usb" in s:   # explicit KVM USB switch, sent before video so the link is still up
        be.set(num(cfg.get("usb_vcp", "0xE7")), num(s["usb"]))
    be.set(VCP_INPUT, num(s["input"]))
    print(f"switched to '{name}' ({fmt_input(num(s['input']))})")


def cmd_switch(be, cfg, args):
    if not args:
        sys.exit("usage: dellmon switch <name>")
    apply_setup(be, cfg, args[0])


def cmd_toggle(be, cfg, _):
    names = list(cfg["setups"])
    if len(names) < 2:
        sys.exit("toggle needs at least 2 setups")
    inp = cur_input(be)
    idx = next((i for i, n in enumerate(names) if num(cfg["setups"][n]["input"]) == inp), -1)
    apply_setup(be, cfg, names[(idx + 1) % len(names)])


def cmd_input(be, cfg, args):
    if not args:
        print(fmt_input(cur_input(be)))
    else:
        be.set(VCP_INPUT, num(args[0]))


def _level(code):
    def f(be, cfg, args):
        if not args:
            cur, mx = be.get(code)
            print(f"{cur} / {mx}")
            return
        a = args[0]
        if a[0] in "+-":
            cur, mx = be.get(code)
            val = max(0, min(mx or 100, cur + int(a)))
        else:
            val = int(a)
        be.set(code, val)
        print(val)
    return f


def cmd_get(be, cfg, args):
    cur, mx = be.get(num(args[0]))
    print(f"0x{cur:04x} ({cur})  max=0x{mx:04x} ({mx})")


def cmd_set(be, cfg, args):
    be.set(num(args[0]), num(args[1]))


def cmd_scan(be, cfg, args):
    be.scan(num(args[0]) if args else 0, num(args[1]) if len(args) > 1 else 0xFF)


def cmd_config(be, cfg, _):
    print(config_path())
    print(json.dumps(cfg, indent=2))


COMMANDS = {
    "status": cmd_status, "learn": cmd_learn, "switch": cmd_switch, "toggle": cmd_toggle,
    "input": cmd_input, "brightness": _level(VCP_BRIGHT), "contrast": _level(VCP_CONTRAST),
    "get": cmd_get, "set": cmd_set, "scan": cmd_scan, "config": cmd_config,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cfg = load_config()
    cmd, args = argv[0], argv[1:]
    if cmd not in COMMANDS:
        if cmd in cfg["setups"]:      # `dellmon linux` shorthand
            cmd, args = "switch", [cmd]
        else:
            sys.exit(f"unknown command '{cmd}'\n{__doc__}")
    try:
        COMMANDS[cmd](backend(cfg), cfg, args)
    except (RuntimeError, subprocess.CalledProcessError) as e:
        sys.exit(f"error: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
